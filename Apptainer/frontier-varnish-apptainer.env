# --- required: identify this instance in configurations/configurations.json ---
SITE=XXX
INSTANCE=01

# --- resource sizing ---
VARNISH_PORT=6082
VARNISH_MEM=8G
VARNISH_TRANSIENT_MEM=500M

# --- apptainer-specific paths (fine to leave as-is) ---
IMAGE=/opt/v4a-apptainer/v4a.sif
VARNISH_WORKDIR=/opt/v4a-apptainer/varnish-workdir

# --- monitoring (required - this is how the instance shows up in Kibana) ---
URL_ML=http://varnish.atlas-ml.org:80/
URL_ML_ACCESS=http://varnish-accesses.atlas-ml.org:80/
